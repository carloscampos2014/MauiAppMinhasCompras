<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Minhas Compras">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Adicionar" x:Name="btnAdicionar" Clicked="btnAdicionar_Clicked" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="auto, *, auto" Padding="10">
        <SearchBar Grid.Row="0"
                   Placeholder="Pesquisar produtos..."
                   x:Name="txtPesquisar"
                   TextChanged="txtPesquisar_TextChanged" />
        <ListView Grid.Row="1" 
                  x:Name="lstProdutos"
                  IsPullToRefreshEnabled="True"
                  Refreshing="lstProdutos_Refreshing"
                  ItemSelected="lstProdutos_ItemSelected">
            <ListView.Header>
                <Grid ColumnDefinitions="30, *, 90, 60, 90" Margin="2, 5, 5, 0">
                    <Label HorizontalOptions="Center"  Grid.Column="0" Text="ID" FontAttributes="Bold" />
                    <Label HorizontalOptions="Start" Grid.Column="1" Text="Descrição" FontAttributes="Bold" />
                    <Label HorizontalOptions="End"  Grid.Column="2" Text="Preço" FontAttributes="Bold" />
                    <Label HorizontalOptions="End" Grid.Column="3" Text="Qtd" FontAttributes="Bold" />
                    <Label HorizontalOptions="End" Grid.Column="4" Text="Total" FontAttributes="Bold" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <ViewCell.ContextActions>
                            <MenuItem Text="Remover" x:Name="mnuRemover" Clicked="mnuRemover_Clicked" />
                        </ViewCell.ContextActions>
                        <Grid ColumnDefinitions="30, *, 90, 60, 90" Margin="2, 0, 5, 5">
                            <Label HorizontalOptions="Center" Grid.Column="0" Text="{Binding Id, StringFormat='{0:D3}'}" />
                            <Label HorizontalOptions="Start" Grid.Column="1" Text="{Binding Descricao}" />
                            <Label HorizontalOptions="End" Grid.Column="2" Text="{Binding Preco, StringFormat='{0:C2}'}" />
                            <Label HorizontalOptions="End" Grid.Column="3" Text="{Binding Quantidade, StringFormat='{0:N0}'}" />
                            <Label HorizontalOptions="End" Grid.Column="4" Text="{Binding Total, StringFormat='{0:C2}'}" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Border Grid.Row="2"
                Stroke="Black"
                StrokeThickness="1"
                Padding="10">
            <Grid ColumnDefinitions="*, auto">
                <Label Grid.Column="0" Text="Total Geral:"
                   FontAttributes="Bold"
                   HorizontalOptions="StartAndExpand" />
                <Label x:Name="lblTotalGeral"
                   Grid.Column="1"
                   Text="R$ 0,00"
                   FontAttributes="Bold"
                   HorizontalOptions="EndAndExpand" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>