<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.EditarProduto"
             Title="{Binding EditarDescricao}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" x:Name="mnuSalvar" Clicked="mnuSalvar_Clicked"  />
        <ToolbarItem Text="Cancelar" x:Name="mnuCancelar" Clicked="mnuCancelar_Clicked" />
    </ContentPage.ToolbarItems>
    <VerticalStackLayout Spacing="10"
                         Padding="10"
                         VerticalOptions="Center">
        <Label Text="Descrição do Produto:" />
        <Entry x:Name="txtDescricao" Text="{Binding Descricao}" MaxLength="100" />

        <Label Text="Quantidade:" />
        <Entry x:Name="txtQuantidade" Text="{Binding Quantidade}" Keyboard="Numeric" />

        <Label Text="Preço Unitário:" />
        <Entry x:Name="txtPrecoUnitario" Text="{Binding Preco}" Keyboard="Numeric" />
    </VerticalStackLayout>
</ContentPage>